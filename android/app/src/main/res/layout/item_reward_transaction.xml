<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="5dp"
    android:background="@drawable/card_rounded_16"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:elevation="2dp">

    <TextView
        android:id="@+id/tv_txn_points"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="64dp"
        android:text="+0"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/vpn_green"
        android:layout_marginEnd="12dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_txn_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/vpn_text_primary" />

        <TextView
            android:id="@+id/tv_txn_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/vpn_text_secondary"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tv_txn_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/vpn_text_secondary"
            android:layout_marginTop="4dp" />

    </LinearLayout>

</LinearLayout>
