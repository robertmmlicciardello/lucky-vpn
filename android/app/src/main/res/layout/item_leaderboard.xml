<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="4dp"
    android:background="@drawable/card_rounded_16"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <TextView
        android:id="@+id/tv_rank"
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="#1"
        android:textColor="@color/vpn_text_secondary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_lb_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Name"
        android:textColor="@color/vpn_text_primary"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tv_lb_points"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="100 pts"
        android:textColor="@color/vpn_blue"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
