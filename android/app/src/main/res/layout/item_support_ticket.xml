<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/card_rounded_16"
    android:orientation="vertical"
    android:padding="14dp"
    android:elevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_ticket_subject"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Subject"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/vpn_text_primary" />

        <TextView
            android:id="@+id/tv_ticket_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="@string/p1_status_open"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/bg_badge_orange" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_ticket_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Message"
        android:textSize="13sp"
        android:textColor="@color/vpn_text_secondary"
        android:layout_marginTop="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/tv_ticket_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="general"
            android:textSize="11sp"
            android:textColor="@color/vpn_blue" />

        <TextView
            android:id="@+id/tv_ticket_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textSize="11sp"
            android:textColor="@color/vpn_text_secondary"
            android:gravity="end" />

    </LinearLayout>

    <!-- Admin response (shown only when present) -->
    <LinearLayout
        android:id="@+id/layout_admin_response"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_admin_response"
        android:padding="10dp"
        android:layout_marginTop="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_admin_response_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/p1_admin_response"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/vpn_blue" />

        <TextView
            android:id="@+id/tv_admin_response"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="13sp"
            android:textColor="@color/vpn_text_primary"
            android:layout_marginTop="4dp" />

    </LinearLayout>

</LinearLayout>
