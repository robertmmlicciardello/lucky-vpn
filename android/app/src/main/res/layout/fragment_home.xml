<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vpn_bg">

    <ScrollView
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Blue gradient header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_gradient_blue"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_shield_logo"
                        android:contentDescription="@string/app_name" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_user_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hello_user"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/white" />

                        <TextView
                            android:id="@+id/tv_user_plan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/stay_safe_connected"
                            android:textSize="13sp"
                            android:textColor="#CCFFFFFF" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Connect section -->
            <LinearLayout
                android:id="@+id/connection_status_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="24dp">

                <!-- Big circular power button -->
                <FrameLayout
                    android:layout_width="210dp"
                    android:layout_height="210dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:id="@+id/iv_connect_ring"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ring_connect_idle"
                        android:contentDescription="@string/connection_status" />

                    <ImageButton
                        android:id="@+id/btn_connect"
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        android:layout_gravity="center"
                        android:background="@drawable/circle_fill_white"
                        android:src="@drawable/ic_power"
                        android:contentDescription="@string/tap_to_connect"
                        android:tint="@color/vpn_blue"
                        android:elevation="4dp" />

                    <!-- Loading overlay -->
                    <FrameLayout
                        android:id="@+id/loading_container"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone"
                        android:background="#B3FFFFFF">

                        <ImageView
                            android:id="@+id/iv_loading_animation"
                            android:layout_width="96dp"
                            android:layout_height="96dp"
                            android:layout_gravity="center"
                            android:src="@drawable/loading_vpn_animation"
                            android:contentDescription="@string/loading_connection" />

                    </FrameLayout>

                </FrameLayout>

                <TextView
                    android:id="@+id/tv_connection_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/disconnected"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/vpn_text_primary" />

                <TextView
                    android:id="@+id/tv_connection_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00:00"
                    android:textSize="14sp"
                    android:textColor="@color/vpn_text_secondary"
                    android:visibility="gone"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp" />

                <!-- Current server card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_rounded_16"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:elevation="2dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/server_location"
                            android:textSize="12sp"
                            android:textColor="@color/vpn_text_secondary" />

                        <TextView
                            android:id="@+id/tv_current_server"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/select_server"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/vpn_text_primary"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_change_server"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="20dp"
                        android:text="@string/change"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:background="@drawable/btn_pill_primary" />

                </LinearLayout>

                <!-- Download / Upload stat cards -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/card_rounded_16"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp"
                        android:elevation="2dp"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/download"
                            android:textSize="12sp"
                            android:textColor="@color/vpn_text_secondary" />

                        <TextView
                            android:id="@+id/tv_download_speed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-- Mbps"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/vpn_blue"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/card_rounded_16"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp"
                        android:elevation="2dp"
                        android:layout_marginStart="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/upload"
                            android:textSize="12sp"
                            android:textColor="@color/vpn_text_secondary" />

                        <TextView
                            android:id="@+id/tv_upload_speed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-- Mbps"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/vpn_blue"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- IP badge row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_rounded_16"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:elevation="2dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/your_ip_address"
                            android:textSize="12sp"
                            android:textColor="@color/vpn_text_secondary" />

                        <TextView
                            android:id="@+id/tv_ip_address"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/vpn_text_primary"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_ip_hidden"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/badge_hidden_bg"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="@string/hidden"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/vpn_green" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Offline State Overlay -->
    <include
        android:id="@+id/offline_layout"
        layout="@layout/layout_offline_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>
