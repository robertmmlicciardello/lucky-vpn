<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/card_rounded_16"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:elevation="2dp"
    android:foreground="?android:attr/selectableItemBackground">

    <!-- Flag emoji -->
    <TextView
        android:id="@+id/tv_flag_emoji"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp"
        android:gravity="center"
        android:text="🌐"
        android:textSize="28sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_server_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Server Name"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/vpn_text_primary" />

        <TextView
            android:id="@+id/tv_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Country - City"
            android:textSize="13sp"
            android:textColor="@color/vpn_text_secondary"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tv_ping"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&lt; 100ms"
                android:textSize="12sp"
                android:textColor="@color/vpn_green"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_load"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textSize="11sp"
                android:textColor="@color/vpn_text_secondary"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <ImageView
            android:id="@+id/iv_signal"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_signal_strong"
            android:contentDescription="@string/signal_strength" />

        <ImageView
            android:id="@+id/iv_selected"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_check_circle"
            android:tint="@color/vpn_blue"
            android:visibility="gone"
            android:contentDescription="@string/selected" />

    </LinearLayout>

</LinearLayout>
