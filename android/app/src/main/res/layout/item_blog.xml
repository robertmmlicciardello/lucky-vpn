<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/card_rounded_16"
    android:foreground="?android:attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_blog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Post title"
        android:textColor="@color/vpn_text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_blog_excerpt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:text="Excerpt"
        android:textColor="@color/vpn_text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tv_blog_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="2026-10-12"
        android:textColor="@color/vpn_blue"
        android:textSize="12sp" />

</LinearLayout>
