<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/card_rounded_16"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:elevation="2dp"
    android:foreground="?android:attr/selectableItemBackground">

    <!-- Unread blue dot -->
    <View
        android:id="@+id/view_unread_dot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/dot_blue"
        android:visibility="invisible" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_notif_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Title"
            android:textSize="15sp"
            android:textColor="@color/vpn_text_primary" />

        <TextView
            android:id="@+id/tv_notif_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Message"
            android:textSize="13sp"
            android:textColor="@color/vpn_text_secondary"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_notif_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="11sp"
            android:textColor="@color/vpn_text_secondary"
            android:layout_marginTop="4dp" />

    </LinearLayout>

</LinearLayout>
