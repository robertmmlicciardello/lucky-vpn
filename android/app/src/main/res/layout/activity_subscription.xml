<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vpn_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/circle_fill_white"
                android:src="@drawable/ic_chevron_right"
                android:rotation="180"
                android:contentDescription="@string/back"
                android:elevation="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/premium_plan"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/vpn_text_primary"
                android:layout_marginStart="12dp" />

        </LinearLayout>

        <!-- Go Premium gradient card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gradient_blue"
            android:orientation="vertical"
            android:padding="24dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_shield_logo"
                android:contentDescription="@string/go_premium"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/go_premium"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/premium_upsell_subtitle"
                android:textSize="14sp"
                android:textColor="#CCFFFFFF"
                android:layout_marginTop="6dp" />

        </LinearLayout>

        <!-- Feature list -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_rounded_16"
            android:orientation="vertical"
            android:padding="20dp"
            android:elevation="2dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/feature_more_servers"
                android:textSize="15sp"
                android:textColor="@color/vpn_text_primary"
                android:drawableStart="@drawable/ic_check_circle"
                android:drawableTint="@color/vpn_green"
                android:drawablePadding="12dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/feature_higher_speed"
                android:textSize="15sp"
                android:textColor="@color/vpn_text_primary"
                android:drawableStart="@drawable/ic_check_circle"
                android:drawableTint="@color/vpn_green"
                android:drawablePadding="12dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/feature_no_ads"
                android:textSize="15sp"
                android:textColor="@color/vpn_text_primary"
                android:drawableStart="@drawable/ic_check_circle"
                android:drawableTint="@color/vpn_green"
                android:drawablePadding="12dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/feature_multi_device"
                android:textSize="15sp"
                android:textColor="@color/vpn_text_primary"
                android:drawableStart="@drawable/ic_check_circle"
                android:drawableTint="@color/vpn_green"
                android:drawablePadding="12dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/feature_priority_support"
                android:textSize="15sp"
                android:textColor="@color/vpn_text_primary"
                android:drawableStart="@drawable/ic_check_circle"
                android:drawableTint="@color/vpn_green"
                android:drawablePadding="12dp" />

        </LinearLayout>

        <!-- Monthly / Yearly price cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/card_rounded_16"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp"
                android:elevation="2dp"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/monthly"
                    android:textSize="14sp"
                    android:textColor="@color/vpn_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/price_monthly"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/vpn_text_primary"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/per_month"
                    android:textSize="12sp"
                    android:textColor="@color/vpn_text_secondary" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/card_rounded_16"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp"
                android:elevation="2dp"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/yearly"
                    android:textSize="14sp"
                    android:textColor="@color/vpn_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/price_yearly"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/vpn_text_primary"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/per_year"
                    android:textSize="12sp"
                    android:textColor="@color/vpn_text_secondary" />

            </LinearLayout>

        </LinearLayout>

        <!-- Current plan -->
        <TextView
            android:id="@+id/tv_current_plan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/current_plan_free"
            android:textSize="14sp"
            android:textColor="@color/vpn_text_secondary"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- Plans list (wired to SubscriptionPlanAdapter) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>

</ScrollView>
